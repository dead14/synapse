# Server
NODE_ENV=development
PORT=8000
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_BODY_LIMIT=15mb
MAX_UPLOAD_BYTES=26214400
MAX_DTW_RECORDS=25000
MAX_DTW_CELLS=4000000
JOB_RESULT_TTL_MS=3600000
# Excel export streams stored session rows and supports up to Excel-scale jobs
# without increasing REQUEST_BODY_LIMIT.
MAX_EXPORT_ROWS=500000
MAX_CONCURRENT_EXPORTS=3
EXPORT_PROCESS_TIMEOUT_MS=600000
EXPORT_JOB_TTL_MS=1800000
MAX_RETAINED_EXPORT_JOBS=10
MAX_USER_EXPORT_JOBS=2
RATE_LIMIT_EXPORT_EXCEL_MAX=10
# Anonymous read-only share links: per-IP fixed-window budget.
RATE_LIMIT_PUBLIC_SHARE_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_SHARE_MAX=120

# Database: use one connection string or all DB_* values below.
DATABASE_URL=postgresql://synapse_user:replace-with-password@localhost:5432/synapse
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=synapse
# DB_USER=synapse_user
# DB_PASSWORD=replace-with-password
# DB_SSL=false

# Connection pool. The pool is shared with the in-process BullMQ workers, so
# these bound how long a slow query can starve incoming requests.
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_QUERY_TIMEOUT_MS=30000

# Redis / BullMQ. REDIS_PASSWORD is required by docker-compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
# REDIS_TLS=false

# One-time optional bootstrap only; never use real values in this file.
# SYNAPSE_ADMIN_ORG_NAME=Example Organization
# SYNAPSE_ADMIN_ORG_SLUG=example-organization
# SYNAPSE_ADMIN_USERNAME=admin
# SYNAPSE_ADMIN_EMAIL=admin@example.invalid
# SYNAPSE_ADMIN_PASSWORD=replace-with-a-strong-password
