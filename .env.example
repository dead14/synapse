# Server
NODE_ENV=development
PORT=8000
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_BODY_LIMIT=15mb
MAX_UPLOAD_BYTES=26214400
MAX_DTW_RECORDS=25000
MAX_DTW_CELLS=4000000
JOB_RESULT_TTL_MS=3600000

# Database: use one connection string or all DB_* values below.
DATABASE_URL=postgresql://synapse_user:replace-with-password@localhost:5432/synapse
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=synapse
# DB_USER=synapse_user
# DB_PASSWORD=replace-with-password
# DB_SSL=false

# One-time optional bootstrap only; never use real values in this file.
# SYNAPSE_ADMIN_ORG_NAME=Example Organization
# SYNAPSE_ADMIN_ORG_SLUG=example-organization
# SYNAPSE_ADMIN_USERNAME=admin
# SYNAPSE_ADMIN_EMAIL=admin@example.invalid
# SYNAPSE_ADMIN_PASSWORD=replace-with-a-strong-password
